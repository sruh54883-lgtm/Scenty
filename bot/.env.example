# Бот читает .env из КОРНЯ проекта (../.env), не из каталога bot/.
# Этот файл — образец нужных ключей.

BOT_TOKEN=
DATABASE_URL=postgresql://localhost:5432/scenti
WEBAPP_URL=https://your-domain.example   # для WebApp-кнопки нужен HTTPS

# Telegram ID супер-админа для уведомлений о новых транзакциях (0 = выключено)
ADMIN_TELEGRAM_ID=0

# Процент кешбэка (по умолчанию 10)
CASHBACK_PERCENT=10
